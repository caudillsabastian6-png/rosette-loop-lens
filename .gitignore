# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.Python

# Tooling / caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Editor / OS
.DS_Store
*.swp
.idea/
.vscode/

# Local environment
*.local
.env

# Crown jewels and run artifacts must NEVER be committed (see steering.md).
# Card banks, keys, master labels, scans, and run-store output stay out of the repo.
secrets/
*.key
*.pem
banks/
runs/
staging/
snapshots/
receipts/

# The .kiro directory (steering + specs) is committed on purpose and must
# never be ignored. Keep this un-ignore last so nothing above can exclude it.
!.kiro/
!.kiro/**
